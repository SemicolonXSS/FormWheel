      (confirmClearOpen ? confirmModalHtml() : "") +
      (authView ? authModalHtml() : "");

    const wheelEl = document.getElementById("wa-wheel-el");
    if (wheelEl && currentRotation !== 0) {
      wheelEl.style.transition = "none";
      wheelEl.style.transform = "rotate(" + currentRotation + "deg)";
      requestAnimationFrame(() => { wheelEl.style.transition = ""; });
    }

    renderForm();

    const spinBtn = document.getElementById("wa-spin-btn");
    if (spinBtn) spinBtn.addEventListener("click", spin);

    const clearBtn = document.getElementById("wa-clear-btn");
    if (clearBtn) clearBtn.addEventListener("click", requestClearAll);

    const copyAllBtn = document.getElementById("wa-copy-all-btn");
    if (copyAllBtn) copyAllBtn.addEventListener("click", copyAllEntries);

    const resetEffectsBtn = document.getElementById("wa-reset-effects-btn");
    if (resetEffectsBtn) resetEffectsBtn.addEventListener("click", resetEffectSettings);

    const durationInput = document.getElementById("wa-duration-input");
    if (durationInput) durationInput.addEventListener("change", (ev) => updateDuration(ev.target.value));

    const roundsInput = document.getElementById("wa-rounds-input");
    if (roundsInput) roundsInput.addEventListener("change", (ev) => updateRounds(ev.target.value));

    const popupStyleSelect = document.getElementById("wa-popup-style-select");
    if (popupStyleSelect) popupStyleSelect.addEventListener("change", (ev) => updatePopupStyle(ev.target.value));

    const popupFontSelect = document.getElementById("wa-popup-font-select");
    if (popupFontSelect) popupFontSelect.addEventListener("change", (ev) => updatePopupFont(ev.target.value));

    const effectSelect = document.getElementById("wa-effect-select");
    if (effectSelect) effectSelect.addEventListener("change", (ev) => updateEffect(ev.target.value));

    for (let gi = 0; gi < 4; gi++) {
      const glitchColorInput = document.getElementById("wa-glitch-color-" + gi);
      if (glitchColorInput) {
        glitchColorInput.addEventListener("change", ((idx) => (ev) => updateGlitchColor(idx, ev.target.value))(gi));
      }
    }

    const bgTypeSelect = document.getElementById("wa-bg-type-select");
    if (bgTypeSelect) bgTypeSelect.addEventListener("change", (ev) => updateBackgroundType(ev.target.value));

    const bgImageInput = document.getElementById("wa-bg-image-input");
    if (bgImageInput) {
      bgImageInput.addEventListener("change", (ev) => {
        const file = ev.target.files && ev.target.files[0];
        if (file) updateBackgroundImage(file);
      });
    }

    const bgImageRemoveBtn = document.getElementById("wa-bg-image-remove");
    if (bgImageRemoveBtn) bgImageRemoveBtn.addEventListener("click", removeBackgroundImage);

    const bgInput = document.getElementById("wa-bg-input");
    if (bgInput) bgInput.addEventListener("change", (ev) => updateBackground(ev.target.value));

    const borderColorInput = document.getElementById("wa-border-color-input");
    if (borderColorInput) borderColorInput.addEventListener("change", (ev) => updateWheelBorderColor(ev.target.value));

    const borderWidthInput = document.getElementById("wa-border-width-input");
    if (borderWidthInput) borderWidthInput.addEventListener("change", (ev) => updateWheelBorderWidth(ev.target.value));

    const hubInput = document.getElementById("wa-hub-input");
    if (hubInput) hubInput.addEventListener("change", (ev) => updateHubColor(ev.target.value));

    const hubTypeSelect = document.getElementById("wa-hub-type-select");
    if (hubTypeSelect) hubTypeSelect.addEventListener("change", (ev) => updateHubType(ev.target.value));

    const hubImageInput = document.getElementById("wa-hub-image-input");
    if (hubImageInput) {
      hubImageInput.addEventListener("change", (ev) => {
        const file = ev.target.files && ev.target.files[0];
        if (file) updateHubImage(file);
      });
    }

    const hubImageRemoveBtn = document.getElementById("wa-hub-image-remove");
    if (hubImageRemoveBtn) hubImageRemoveBtn.addEventListener("click", removeHubImage);

    const hubShapeSelect = document.getElementById("wa-hub-shape-select");
    if (hubShapeSelect) hubShapeSelect.addEventListener("change", (ev) => updateHubShape(ev.target.value));

    const wheelShapeSelect = document.getElementById("wa-wheel-shape-select");
    if (wheelShapeSelect) wheelShapeSelect.addEventListener("change", (ev) => updateWheelShape(ev.target.value));

    const presetNameInput = document.getElementById("wa-preset-name-input");
    if (presetNameInput) presetNameInput.addEventListener("input", (ev) => { presetNameInputValue = ev.target.value; });
    const presetSaveBtn = document.getElementById("wa-preset-save-btn");
    if (presetSaveBtn) presetSaveBtn.addEventListener("click", saveCurrentPreset);
    userPresets.forEach((p) => {
      const loadBtn = document.getElementById("wa-preset-load-" + p.id);
      const delBtn = document.getElementById("wa-preset-del-" + p.id);
      if (loadBtn) loadBtn.addEventListener("click", () => loadPreset(p.id));
      if (delBtn) delBtn.addEventListener("click", () => deletePreset(p.id));
    });

    entries.forEach((e) => {
      const delBtn = document.getElementById("wa-del-" + e.id);
      const editBtn = document.getElementById("wa-edit-" + e.id);
      const weightInput = document.getElementById("wa-weight-" + e.id);
      const colorInput = document.getElementById("wa-color-" + e.id);
      if (delBtn) delBtn.addEventListener("click", () => deleteEntry(e.id));
      if (editBtn) editBtn.addEventListener("click", () => { editingId = e.id; render(); });
      if (weightInput) weightInput.addEventListener("change", (ev) => updateWeight(e.id, ev.target.value));
      if (colorInput) colorInput.addEventListener("change", (ev) => updateEntryColor(e.id, ev.target.value));
    });

    if (editingId) {
      const saveBtn = document.getElementById("wa-save-edit");
      const cancelBtn = document.getElementById("wa-cancel-edit");
      if (saveBtn) {
        saveBtn.addEventListener("click", () => {
          const label = document.getElementById("wa-edit-label").value;
          updateEntry(editingId, label);
        });
      }
      if (cancelBtn) cancelBtn.addEventListener("click", () => { editingId = null; render(); });
    }

    // 당첨 팝업
    if (winnerModalOpen && lastWinner) {
      const overlay = document.getElementById("wa-winner-overlay");
      const closeBtn = document.getElementById("wa-winner-close");
      const deleteBtn = document.getElementById("wa-winner-delete");
      if (closeBtn) closeBtn.addEventListener("click", closeWinnerModal);
      if (deleteBtn) deleteBtn.addEventListener("click", deleteWinnerEntry);
      if (overlay) overlay.addEventListener("click", (ev) => { if (ev.target === overlay) closeWinnerModal(); });
      if (!effectStarted) {
        effectStarted = true;
        startEffect();
      }
    } else {
      effectStarted = false;
    }

    // 전체 삭제 확인 팝업
    if (confirmClearOpen) {
      const cOverlay = document.getElementById("wa-confirm-overlay");
      const okBtn = document.getElementById("wa-confirm-ok");
      const cancelBtn2 = document.getElementById("wa-confirm-cancel");
      if (okBtn) okBtn.addEventListener("click", confirmClearAll);
      if (cancelBtn2) cancelBtn2.addEventListener("click", cancelClearAll);
      if (cOverlay) cOverlay.addEventListener("click", (ev) => { if (ev.target === cOverlay) cancelClearAll(); });
    }

    // 로그인/회원가입/인증 팝업
    const openLoginBtn = document.getElementById("wa-open-login");
    if (openLoginBtn) openLoginBtn.addEventListener("click", () => { authView = "login"; resetAuthForm(); render(); });
    const openSignupBtn = document.getElementById("wa-open-signup");
    if (openSignupBtn) openSignupBtn.addEventListener("click", () => { authView = "signup"; resetAuthForm(); render(); });
    const logoutBtn = document.getElementById("wa-logout-btn");
    if (logoutBtn) logoutBtn.addEventListener("click", logout);

    if (authView) {
      const overlay = document.getElementById("wa-auth-overlay");
      const cancelBtn = document.getElementById("wa-auth-cancel");
      const submitBtn = document.getElementById("wa-auth-submit");
      const gotoSignup = document.getElementById("wa-auth-goto-signup");
      const gotoLogin = document.getElementById("wa-auth-goto-login");
      const emailInput = document.getElementById("wa-auth-email");
      const pwInput = document.getElementById("wa-auth-password");
      const confirmInput = document.getElementById("wa-auth-confirm");
      const notRobotInput = document.getElementById("wa-auth-notrobot");

      if (emailInput) emailInput.addEventListener("input", (ev) => { authForm.email = ev.target.value; });
      if (pwInput) pwInput.addEventListener("input", (ev) => { authForm.password = ev.target.value; });
      if (confirmInput) confirmInput.addEventListener("input", (ev) => { authForm.confirm = ev.target.value; });
      if (notRobotInput) notRobotInput.addEventListener("change", (ev) => { authForm.notRobot = ev.target.checked; });

      if (cancelBtn) cancelBtn.addEventListener("click", () => { authView = null; resetAuthForm(); render(); });
      if (overlay) overlay.addEventListener("click", (ev) => { if (ev.target === overlay) { authView = null; resetAuthForm(); render(); } });
      if (gotoSignup) gotoSignup.addEventListener("click", () => { authView = "signup"; authForm.error = ""; render(); });
      if (gotoLogin) gotoLogin.addEventListener("click", () => { authView = "login"; authForm.error = ""; render(); });
      if (submitBtn) {
        submitBtn.addEventListener("click", () => {
          if (authView === "login") submitLogin();
          else if (authView === "signup") submitSignup();
        });
      }
    }
  }

  function optionHtml(value, current, label) {
    return '<option value="' + value + '" ' + (value === current ? "selected" : "") + '>' + label + '</option>';
  }

  function buildNotesFooter() {
    if (!lastWinner || !lastWinner.note || winnerModalOpen) return "";
    return '<div class="wa-footer-notes">' + escapeHtml(lastWinner.note) + "</div>";
  }

  function winnerModalHtml() {
    const popupFontFamily = POPUP_FONTS[settings.popupFont] || POPUP_FONTS.default;
    return (
      '<div class="wa-modal-overlay" id="wa-winner-overlay">' +
        '<canvas class="wa-effect-canvas" id="wa-effect-canvas"></canvas>' +
        '<div class="wa-modal-card wa-modal-' + settings.popupStyle + '">' +
          '<div class="wa-modal-label">당첨</div>' +
          '<div class="wa-modal-text" style="font-family:' + popupFontFamily + ';">' + escapeHtml(lastWinner.label) + '</div>' +
          '<div class="wa-modal-actions">' +
            '<button class="wa-btn wa-btn-ghost" id="wa-winner-delete" style="flex:1;">이 항목 삭제하기</button>' +
            '<button class="wa-btn wa-btn-primary" id="wa-winner-close" style="flex:1;">확인</button>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function confirmModalHtml() {
    return (
      '<div class="wa-modal-overlay" id="wa-confirm-overlay">' +
        '<div class="wa-modal-card wa-modal-minimal wa-confirm-card">' +
          '<p class="wa-confirm-title">항목을 전부 삭제할까요?</p>' +
          '<p class="wa-confirm-body">되돌릴 수 없어요.</p>' +
          '<div class="wa-confirm-actions">' +
            '<button class="wa-btn wa-btn-ghost" id="wa-confirm-cancel" style="flex:1;">취소</button>' +
            '<button class="wa-btn wa-btn-primary" id="wa-confirm-ok" style="flex:1;">전체 삭제</button>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function authModalHtml() {
    let body = "";
    if (authView === "login") {
      body =
        '<p class="wa-confirm-title">로그인</p>' +
        (authForm.error ? '<p class="wa-auth-error">' + escapeHtml(authForm.error) + '</p>' : '') +
        '<div class="wa-auth-field"><label for="wa-auth-email">이메일</label>' +
          '<input class="wa-input" id="wa-auth-email" type="email" value="' + escapeAttr(authForm.email) + '" ' + (authBusy ? "disabled" : "") + '></div>' +
        '<div class="wa-auth-field"><label for="wa-auth-password">비밀번호</label>' +
          '<input class="wa-input" id="wa-auth-password" type="password" value="' + escapeAttr(authForm.password) + '" ' + (authBusy ? "disabled" : "") + '></div>' +
        '<div class="wa-confirm-actions">' +
          '<button class="wa-btn wa-btn-ghost" id="wa-auth-cancel" style="flex:1;" ' + (authBusy ? "disabled" : "") + '>취소</button>' +
          '<button class="wa-btn wa-btn-primary" id="wa-auth-submit" style="flex:1;" ' + (authBusy ? "disabled" : "") + '>로그인</button>' +
        '</div>' +
        '<p class="wa-auth-switch">계정이 없으신가요? <button id="wa-auth-goto-signup">회원가입</button></p>';
    } else if (authView === "signup") {
      body =
        '<p class="wa-confirm-title">회원가입</p>' +
        (authForm.error ? '<p class="wa-auth-error">' + escapeHtml(authForm.error) + '</p>' : '') +
        '<div class="wa-auth-field"><label for="wa-auth-email">이메일</label>' +
          '<input class="wa-input" id="wa-auth-email" type="email" value="' + escapeAttr(authForm.email) + '" ' + (authBusy ? "disabled" : "") + '></div>' +
        '<div class="wa-auth-field"><label for="wa-auth-password">비밀번호 (6자 이상)</label>' +
          '<input class="wa-input" id="wa-auth-password" type="password" value="' + escapeAttr(authForm.password) + '" ' + (authBusy ? "disabled" : "") + '></div>' +
        '<div class="wa-auth-field"><label for="wa-auth-confirm">비밀번호 확인</label>' +
          '<input class="wa-input" id="wa-auth-confirm" type="password" value="' + escapeAttr(authForm.confirm) + '" ' + (authBusy ? "disabled" : "") + '></div>' +
        '<div class="wa-captcha-row">' +
          '<input type="checkbox" id="wa-auth-notrobot" ' + (authForm.notRobot ? "checked" : "") + ' ' + (authBusy ? "disabled" : "") + '>' +
          '<label for="wa-auth-notrobot">저는 로봇이 아닙니다</label>' +
        '</div>' +
        '<div class="wa-confirm-actions">' +
          '<button class="wa-btn wa-btn-ghost" id="wa-auth-cancel" style="flex:1;" ' + (authBusy ? "disabled" : "") + '>취소</button>' +
          '<button class="wa-btn wa-btn-primary" id="wa-auth-submit" style="flex:1;" ' + (authBusy ? "disabled" : "") + '>가입하기</button>' +
        '</div>' +
        '<p class="wa-auth-switch">이미 계정이 있으신가요? <button id="wa-auth-goto-login">로그인</button></p>';
    }
    return (
      '<div class="wa-modal-overlay" id="wa-auth-overlay">' +
        '<div class="wa-modal-card wa-modal-minimal wa-confirm-card">' + body + '</div>' +
      '</div>'
    );
  }

  function renderForm() {
    const slot = document.getElementById("wa-form-slot");
    if (!slot) return;
    slot.innerHTML =
      '<div class="wa-form-row" style="flex-direction:column;">' +
        '<textarea class="wa-input" id="wa-new-input" rows="2" placeholder="[어쩌고] [저쩌고]  또는  줄바꿈으로 한 줄씩" style="resize:vertical;" ' + (spinning ? "disabled" : "") + '></textarea>' +
      '</div>' +
      '<div class="wa-form-row">' +
        '<button class="wa-btn wa-btn-primary" id="wa-add-btn" style="width:100%;" ' + (spinning ? "disabled" : "") + '>추가</button>' +
      '</div>' +
      '<p class="wa-hint">예: <code>[인터스텔라] [듄] [기생충-3]</code> 처럼 <code>-숫자</code>를 붙이면 그 항목 초기 크기(가중치)가 바로 설정돼요. 나중에 목록에서 항목 옆 숫자로도 언제든 조절할 수 있어요.</p>';

    const addBtn = document.getElementById("wa-add-btn");
    const box = document.getElementById("wa-new-input");

    function doAdd() {
      const labels = parseInputToLabels(box.value);
      if (labels.length === 0) return;
      labels.forEach((raw) => {
        const { label, note, weight } = parseEntryFromRaw(raw);
        entries.push({ id: uid(), label: label, note: note, weight: weight });
      });
      saveEntries();
      box.value = "";
      render();
    }

    addBtn.addEventListener("click", doAdd);
    box.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" && (ev.metaKey || ev.ctrlKey)) doAdd();
    });
  }

  function entryRowHtml(e, i) {
    if (editingId === e.id) {
      return (
        '<div class="wa-entry" style="flex-direction:column;align-items:stretch;gap:6px;">' +
          '<input class="wa-input" id="wa-edit-label" value="' + escapeAttr(e.label) + '" />' +
          '<div style="display:flex;gap:6px;">' +
            '<button class="wa-btn wa-btn-primary" id="wa-save-edit" style="flex:1;">저장</button>' +
            '<button class="wa-btn wa-btn-ghost" id="wa-cancel-edit" style="flex:1;">취소</button>' +
          '</div>' +
        '</div>'
      );
    }
    const color = e.color || PALETTE[i % PALETTE.length];
    return (
      '<div class="wa-entry">' +
        '<input type="color" class="wa-color-input" id="wa-color-' + e.id + '" value="' + color + '" ' + (!currentUser || spinning ? "disabled" : "") + ' title="' + (currentUser ? "항목 색상" : "항목 색상 (로그인 후 변경 가능)") + '">' +
        '<span class="wa-entry-text">' + escapeHtml(e.label) + '</span>' +
        '<input type="number" class="wa-input wa-weight-input" id="wa-weight-' + e.id + '" min="' + WEIGHT_MIN + '" max="' + WEIGHT_MAX + '" step="1" value="' + (e.weight || 1) + '" title="크기 (칸 비율, 클수록 당첨 확률 높음)" ' + (spinning ? "disabled" : "") + '>' +
        '<span class="wa-entry-actions">' +
          '<button class="wa-icon-btn" id="wa-edit-' + e.id + '" ' + (spinning ? "disabled" : "") + '>수정</button>' +
          '<button class="wa-icon-btn" id="wa-del-' + e.id + '" ' + (spinning ? "disabled" : "") + '>삭제</button>' +
        '</span>' +
      '</div>'
    );
  }

  function presetRowHtml(p) {
    return (
      '<div class="wa-entry">' +
        '<span class="wa-entry-text">' + escapeHtml(p.name) + ' <span style="opacity:.55;font-weight:400;">(' + p.entries.length + '개)</span></span>' +
        '<span class="wa-entry-actions">' +
          '<button class="wa-icon-btn" id="wa-preset-load-' + p.id + '" ' + (spinning ? "disabled" : "") + '>불러오기</button>' +
          '<button class="wa-icon-btn" id="wa-preset-del-' + p.id + '" ' + (spinning ? "disabled" : "") + '>삭제</button>' +
        '</span>' +
      '</div>'
    );
  }

  function truncate(s, n) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  }
  function escapeAttr(s) { return escapeHtml(s); }

  async function init() {
    await loadSettings();
    await loadEntries();
    await loadUsers();
    await loadSession();
    await loadPresetsStore();
    if (currentUser && !users.find((u) => u.email === currentUser.email && u.verified)) {
      currentUser = null;
    }
    render();
  }

  init();
})();
</script>
</body>
</html>
