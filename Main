  // --- 항목별 사진 업로드 (로그인 필요): 정사각형으로 크롭 후 돌림판 부채꼴에 클립되어 표시됨 ---
  function updateEntryImage(id, file) {
    if (!currentUser || spinning || !file) return;
    const reader = new FileReader();
    reader.onload = function (ev) {
      const img = new Image();
      img.onload = function () {
        const size = 320;
        const canvas = document.createElement("canvas");
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext("2d");
        const s = Math.min(img.width, img.height);
        const sx = (img.width - s) / 2;
        const sy = (img.height - s) / 2;
        ctx.drawImage(img, sx, sy, s, s, 0, 0, size, size);
        const e = entries.find((x) => x.id === id);
        if (e) {
          e.image = canvas.toDataURL("image/jpeg", 0.85);
          saveEntries();
          render();
        }
      };
      img.onerror = function () { /* 이미지를 읽지 못하면 조용히 무시 */ };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function removeEntryImage(id) {
    if (!currentUser) return;
    const e = entries.find((x) => x.id === id);
    if (!e) return;
    e.image = null;
    saveEntries();
    render();
  }

  // 항목별 weight(크기)를 반영해 부채꼴 각도를 계산. 순서는 entries 배열 순서와 동일.
  function computeSlices(list) {
    const total = list.reduce((s, e) => s + (e.weight || 1), 0) || 1;
    let acc = 0;
    return list.map((e) => {
      const w = e.weight || 1;
      const sliceAngle = (w / total) * 360;
      const start = acc;
      const end = acc + sliceAngle;
      acc = end;
      return { entry: e, start, end, mid: (start + end) / 2, sliceAngle };
    });
  }

  function spin() {
    if (spinning || entries.length === 0) return;
    spinning = true;

    const spinBtn = document.getElementById("wa-spin-btn");
    if (spinBtn) { spinBtn.disabled = true; spinBtn.textContent = t("spinning"); }
    const winnerBox = document.querySelector(".wa-winner");
    if (winnerBox) winnerBox.innerHTML = "";

    setInputsDisabled(true);

    const n = entries.length;
    const slices = computeSlices(entries);
    const totalWeight = entries.reduce((s, e) => s + (e.weight || 1), 0) || 1;

    let r = Math.random() * totalWeight;
    let winnerIndex = n - 1;
    let acc = 0;
    for (let i = 0; i < n; i++) {
      acc += entries[i].weight || 1;
      if (r < acc) { winnerIndex = i; break; }
    }

    const slice = slices[winnerIndex];
    const jitter = (Math.random() - 0.5) * slice.sliceAngle * 0.6;
    const centerAngle = slice.mid + jitter;
    const fullSpins = settings.rounds + Math.floor(Math.random() * 2);
    const targetMod = (360 - centerAngle + 360) % 360;
    const nextRotation = currentRotation - (currentRotation % 360) + fullSpins * 360 + targetMod;

    const wheelEl = document.getElementById("wa-wheel-el");
    wheelEl.style.transition = "transform " + settings.duration + "s cubic-bezier(0.16, 1, 0.3, 1)";
    void wheelEl.offsetWidth;
    wheelEl.style.transform = "rotate(" + nextRotation + "deg)";
    currentRotation = nextRotation;

    setTimeout(() => {
      spinning = false;
      lastWinner = entries[winnerIndex];
      winnerModalOpen = true;
      render();
    }, settings.duration * 1000 + 100);
  }

  function closeWinnerModal() {
    winnerModalOpen = false;
    stopEffect();
    render();
  }

  function setInputsDisabled(disabled) {
    ["wa-duration-input", "wa-rounds-input", "wa-popup-style-select", "wa-popup-font-select", "wa-effect-select", "wa-clear-btn", "wa-add-btn", "wa-bg-type-select", "wa-bg-input", "wa-bg-image-input", "wa-border-color-input", "wa-border-width-input", "wa-slice-text-color-input", "wa-slice-border-color-input", "wa-wheel-shape-select", "wa-hub-input", "wa-hub-type-select", "wa-hub-shape-select", "wa-hub-image-input", "wa-glitch-color-0", "wa-glitch-color-1", "wa-glitch-color-2", "wa-glitch-color-3", "wa-preset-name-input", "wa-preset-save-btn", "wa-lang-select", "wa-neon-color-input", "wa-lightning-color-input", "wa-matrix-color-input", "wa-bubble-color-input", "wa-secret-code-input", "wa-secret-code-btn"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.disabled = disabled;
    });
  }

  // ---------- 폭죽 / 불꽃놀이 효과 ----------
  function startEffect() {
    if (settings.effect === "none") return;
    if (settings.effect === "glitch" && !currentUser) return; // 로그인 없이 저장된 값이어도 재생하지 않음
    if (SECRET_EFFECTS.includes(settings.effect) && !settings.secretUnlocked) return; // 시크릿 코드 없이 저장된 값이어도 재생하지 않음
    const canvas = document.getElementById("wa-effect-canvas");
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext("2d");

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    let rafId = null;
    const startTime = performance.now();
    const duration = 3400;

    if (settings.effect === "confetti") {
      const particles = [];
      const count = 150;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.6,
          w: 6 + Math.random() * 6,
          h: 8 + Math.random() * 10,
          color: EFFECT_COLORS[Math.floor(Math.random() * EFFECT_COLORS.length)],
          vy: 2 + Math.random() * 3,
          vx: -1.2 + Math.random() * 2.4,
          rot: Math.random() * 360,
          vr: -6 + Math.random() * 12,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vr;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "fireworks") {
      let bursts = [];
      let nextBurstAt = 0;

      function spawnBurst() {
        const bx = canvas.width * (0.18 + Math.random() * 0.64);
        const by = canvas.height * (0.15 + Math.random() * 0.3);
        const color = EFFECT_COLORS[Math.floor(Math.random() * EFFECT_COLORS.length)];
        const parts = [];
        const count = 40;
        for (let i = 0; i < count; i++) {
          const angle = (i / count) * Math.PI * 2;
          const speed = 2 + Math.random() * 3;
          parts.push({
            x: bx, y: by,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1,
            color,
          });
        }
        bursts.push(parts);
      }

      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (now >= nextBurstAt && now - startTime < duration - 700 && bursts.length < 6) {
          spawnBurst();
          nextBurstAt = now + 420 + Math.random() * 320;
        }
        bursts.forEach((parts) => {
          parts.forEach((p) => {
            p.vy += 0.035;
            p.x += p.vx;
            p.y += p.vy;
            p.life -= 0.013;
          });
        });
        bursts = bursts.map((parts) => parts.filter((p) => p.life > 0)).filter((parts) => parts.length > 0);

        bursts.forEach((parts) => {
          parts.forEach((p) => {
            ctx.globalAlpha = Math.max(p.life, 0);
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
            ctx.fill();
          });
        });
        ctx.globalAlpha = 1;

        if (now - startTime < duration || bursts.length > 0) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "sparkle") {
      const particles = [];
      const count = 60;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          size: 12 + Math.random() * 16,
          tw: Math.random() * Math.PI * 2,
          vx: -0.3 + Math.random() * 0.6,
          vy: -0.3 + Math.random() * 0.6,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const life = Math.max(0, 1 - (now - startTime) / duration);
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          const alpha = Math.max(0, Math.sin(now / 160 + p.tw)) * life;
          ctx.globalAlpha = alpha;
          ctx.font = p.size + "px serif";
          ctx.fillText("✨", p.x, p.y);
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "hearts") {
      const hearts = ["❤️", "💛", "💚", "💙", "💜"];
      const particles = [];
      const count = 70;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: canvas.height + 20 + Math.random() * canvas.height * 0.4,
          size: 16 + Math.random() * 18,
          char: hearts[Math.floor(Math.random() * hearts.length)],
          vy: -(1.4 + Math.random() * 2),
          swayPhase: Math.random() * Math.PI * 2,
          swayAmp: 10 + Math.random() * 20,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => {
          p.y += p.vy;
          const life = Math.max(0, Math.min(1, (canvas.height - p.y) / canvas.height));
          ctx.globalAlpha = Math.max(0, 1 - (now - startTime) / duration + 0.3);
          ctx.font = p.size + "px serif";
          ctx.fillText(p.char, p.x + Math.sin(now / 400 + p.swayPhase) * p.swayAmp, p.y);
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "glitch") {
      const glitchColors = (Array.isArray(settings.glitchColors) && settings.glitchColors.length)
        ? settings.glitchColors
        : DEFAULT_SETTINGS.glitchColors;
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = 0.06;
        ctx.fillStyle = "#000000";
        for (let y = 0; y < canvas.height; y += 4) ctx.fillRect(0, y, canvas.width, 2);
        const barCount = 5 + Math.floor(Math.random() * 7);
        for (let i = 0; i < barCount; i++) {
          const y = Math.random() * canvas.height;
          const h = 4 + Math.random() * 34;
          const xOffset = (Math.random() - 0.5) * 70;
          const color = glitchColors[Math.floor(Math.random() * glitchColors.length)];
          ctx.globalAlpha = 0.45 + Math.random() * 0.45;
          ctx.fillStyle = color;
          ctx.fillRect(xOffset, y, canvas.width, h);
        }
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "snow") {
      const particles = [];
      const count = 110;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.6,
          size: 2 + Math.random() * 4,
          vy: 0.7 + Math.random() * 1.6,
          swayPhase: Math.random() * Math.PI * 2,
          swayAmp: 8 + Math.random() * 24,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#FFFFFF";
        particles.forEach((p) => {
          p.y += p.vy;
          const x = p.x + Math.sin(now / 900 + p.swayPhase) * p.swayAmp * 0.03;
          ctx.globalAlpha = 0.85;
          ctx.beginPath();
          ctx.arc(x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "balloons") {
      const colors = EFFECT_COLORS;
      const particles = [];
      const count = 22;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: canvas.height + 40 + Math.random() * canvas.height * 0.5,
          size: 22 + Math.random() * 20,
          color: colors[Math.floor(Math.random() * colors.length)],
          vy: -(0.8 + Math.random() * 1.4),
          swayPhase: Math.random() * Math.PI * 2,
          swayAmp: 14 + Math.random() * 22,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => {
          p.y += p.vy;
          const x = p.x + Math.sin(now / 700 + p.swayPhase) * p.swayAmp * 0.05;
          ctx.globalAlpha = Math.max(0, 1 - (now - startTime) / duration + 0.35);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.ellipse(x, p.y, p.size * 0.62, p.size, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = p.color;
          ctx.globalAlpha = Math.max(0, (1 - (now - startTime) / duration + 0.35)) * 0.6;
          ctx.beginPath();
          ctx.moveTo(x, p.y + p.size);
          ctx.lineTo(x, p.y + p.size + 26);
          ctx.stroke();
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "bubbles") {
      const bubbleColor = settings.bubbleColor || DEFAULT_SETTINGS.bubbleColor;
      const particles = [];
      const count = 55;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: canvas.height + 20 + Math.random() * canvas.height * 0.5,
          size: 6 + Math.random() * 16,
          vy: -(0.9 + Math.random() * 1.8),
          swayPhase: Math.random() * Math.PI * 2,
          swayAmp: 6 + Math.random() * 18,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => {
          p.y += p.vy;
          const x = p.x + Math.sin(now / 500 + p.swayPhase) * p.swayAmp * 0.05;
          const alpha = Math.max(0, 1 - (now - startTime) / duration + 0.3);
          ctx.globalAlpha = alpha * 0.55;
          ctx.strokeStyle = bubbleColor;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.arc(x, p.y, p.size, 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = alpha * 0.25;
          ctx.fillStyle = "#FFFFFF";
          ctx.beginPath();
          ctx.arc(x - p.size * 0.3, p.y - p.size * 0.3, p.size * 0.25, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "money") {
      const bills = ["💵", "💰", "🪙", "💸"];
      const particles = [];
      const count = 70;
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: -20 - Math.random() * canvas.height * 0.6,
          size: 16 + Math.random() * 16,
          char: bills[Math.floor(Math.random() * bills.length)],
          vy: 1.6 + Math.random() * 2.6,
          rot: Math.random() * 360,
          vr: -5 + Math.random() * 10,
        });
      }
      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p) => {
          p.y += p.vy;
          p.rot += p.vr;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.font = p.size + "px serif";
          ctx.textAlign = "center";
          ctx.fillText(p.char, 0, 0);
          ctx.restore();
        });
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "lightning") {
      const lightningColor = settings.lightningColor || DEFAULT_SETTINGS.lightningColor;
      let bolts = [];
      let nextBoltAt = 0;
      let flashAlpha = 0;

      function spawnBolt() {
        const startX = canvas.width * (0.15 + Math.random() * 0.7);
        let x = startX, y = 0;
        const points = [{ x, y }];
        const segments = 8 + Math.floor(Math.random() * 5);
        for (let i = 0; i < segments; i++) {
          x += (Math.random() - 0.5) * 70;
          y += canvas.height / segments;
          points.push({ x, y });
        }
        bolts.push({ points, life: 1 });
        flashAlpha = 0.55;
      }

      function frame(now) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (now >= nextBoltAt && now - startTime < duration - 300) {
          spawnBolt();
          nextBoltAt = now + 450 + Math.random() * 650;
        }
        if (flashAlpha > 0) {
          ctx.fillStyle = "rgba(225,230,255," + flashAlpha.toFixed(2) + ")";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          flashAlpha -= 0.05;
        }
        bolts.forEach((b) => { b.life -= 0.12; });
        bolts = bolts.filter((b) => b.life > 0);
        bolts.forEach((b) => {
          ctx.globalAlpha = Math.max(b.life, 0);
          ctx.strokeStyle = lightningColor;
          ctx.lineWidth = 2.4;
          ctx.shadowColor = lightningColor;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          b.points.forEach((p, i) => { if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y); });
          ctx.stroke();
          ctx.shadowBlur = 0;
        });
        ctx.globalAlpha = 1;
        if (now - startTime < duration || bolts.length > 0) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    } else if (settings.effect === "matrix") {
      const matrixColor = settings.matrixColor || DEFAULT_SETTINGS.matrixColor;
      const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
      const fontSize = 16;
      const cols = Math.max(1, Math.floor(canvas.width / fontSize));
      const drops = new Array(cols).fill(0).map(() => Math.random() * (canvas.height / fontSize));
      function frame(now) {
        ctx.fillStyle = "rgba(6,10,8,0.16)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.font = fontSize + "px 'Courier New', monospace";
        ctx.fillStyle = matrixColor;
        for (let i = 0; i < cols; i++) {
          const ch = chars[Math.floor(Math.random() * chars.length)];
          const x = i * fontSize;
          const y = drops[i] * fontSize;
          ctx.fillText(ch, x, y);
          if (y > canvas.height && Math.random() > 0.975) drops[i] = 0;
          drops[i]++;
        }
        if (now - startTime < duration) {
          rafId = requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      rafId = requestAnimationFrame(frame);
    }

    effectCleanup = () => {
      if (rafId) cancelAnimationFrame(rafId);
      window.removeEventListener("resize", resize);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    };
  }

  function stopEffect() {
    if (effectCleanup) {
      effectCleanup();
      effectCleanup = null;
    }
    effectStarted = false;
  }

  // 다각형 모양 정의: 정n각형의 변 수와 회전각(위쪽 꼭짓점 기준)
  const POLY_SHAPES = {
    square: { sides: 4, rotation: 45 },
    triangle: { sides: 3, rotation: 0 },
    diamond: { sides: 4, rotation: 0 },
    pentagon: { sides: 5, rotation: 0 },
    hexagon: { sides: 6, rotation: 0 },
  };

  function polygonPointsSvg(cx, cy, r, shape) {
    const def = POLY_SHAPES[shape] || POLY_SHAPES.square;
    const pts = [];
    for (let i = 0; i < def.sides; i++) {
      const angle = (def.rotation + (i * 360) / def.sides - 90) * Math.PI / 180;
      pts.push((cx + r * Math.cos(angle)).toFixed(2) + "," + (cy + r * Math.sin(angle)).toFixed(2));
    }
    return pts.join(" ");
  }

  // 돌림판 바깥 테두리용 CSS clip-path (퍼센트 좌표계, 중심 50% 반지름 50%)
  function polygonClipPathCss(shape) {
    const def = POLY_SHAPES[shape] || POLY_SHAPES.square;
    const pts = [];
    for (let i = 0; i < def.sides; i++) {
      const angle = (def.rotation + (i * 360) / def.sides - 90) * Math.PI / 180;
      const x = (50 + 50 * Math.cos(angle)).toFixed(2);
      const y = (50 + 50 * Math.sin(angle)).toFixed(2);
      pts.push(x + "% " + y + "%");
    }
    return "polygon(" + pts.join(", ") + ")";
  }

  function wheelShapeStyle(shape) {
    if (shape === "square") return { borderRadius: "18px", clipPath: "none" };
    if (shape && POLY_SHAPES[shape]) return { borderRadius: "0", clipPath: polygonClipPathCss(shape) };
    return { borderRadius: "50%", clipPath: "none" };
  }

  // 중앙 원 스타일: 단색 / 레인보우(부채꼴로 무지개 근사) / 사진(모양대로 클립) / 없음
  // + 모양: 원 / 사각형 / 삼각형 / 다이아몬드 / 오각형 / 육각형 (로그인 필요)
  function buildHubMarkup(cx, cy, r) {
    const type = settings.hubType || "color";
    if (type === "none") return "";
    const shape = settings.hubShape || "circle";
    const isCircle = shape === "circle" || !POLY_SHAPES[shape];
    const shapeTag = isCircle
      ? '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '"'
      : '<polygon points="' + polygonPointsSvg(cx, cy, r, shape) + '"';
    const outline = shapeTag + ' fill="none" stroke="#242338" stroke-width="4"/>';

    if (type === "image" && settings.hubImage) {
      return (
        '<defs><clipPath id="wa-hub-clip">' + shapeTag + '/></clipPath></defs>' +
        '<image href="' + settings.hubImage + '" x="' + (cx - r) + '" y="' + (cy - r) + '" width="' + (r * 2) + '" height="' + (r * 2) + '" clip-path="url(#wa-hub-clip)" preserveAspectRatio="xMidYMid slice"/>' +
        outline
      );
    }
    if (type === "rainbow") {
      const segs = 24;
      let arcs = "";
      for (let i = 0; i < segs; i++) {
        const a1 = (i / segs) * 360;
        const a2 = ((i + 1) / segs) * 360;
        const a1r = (a1 - 90) * Math.PI / 180;
        const a2r = (a2 - 90) * Math.PI / 180;
        const x1 = (cx + r * Math.cos(a1r)).toFixed(2);
        const y1 = (cy + r * Math.sin(a1r)).toFixed(2);
        const x2 = (cx + r * Math.cos(a2r)).toFixed(2);
        const y2 = (cy + r * Math.sin(a2r)).toFixed(2);
        const hue = Math.round((i / segs) * 360);
        arcs += '<path d="M ' + cx + ',' + cy + ' L ' + x1 + ',' + y1 + ' A ' + r + ',' + r + ' 0 0 1 ' + x2 + ',' + y2 + ' Z" fill="hsl(' + hue + ',85%,60%)"/>';
      }
      return (
        '<defs><clipPath id="wa-hub-clip">' + shapeTag + '/></clipPath></defs>' +
        '<g clip-path="url(#wa-hub-clip)">' + arcs + '</g>' +
        outline
      );
    }
    // 기본: 단색
    return shapeTag + ' fill="' + (settings.hubColor || DEFAULT_SETTINGS.hubColor) + '" stroke="#242338" stroke-width="4"/>';
  }

  function buildWheelSvg(entries) {
    const cx = 160, cy = 160, r = 150, textR = 100;
    const n = entries.length;
    if (n === 0) {
      return '<svg viewBox="0 0 320 320" width="100%" height="100%"><circle cx="160" cy="160" r="150" fill="#2D2B47"/></svg>';
    }
    let shapes = "";
    let labels = "";
    const textColor = settings.sliceTextColor || DEFAULT_SETTINGS.sliceTextColor;
    const borderColor = settings.sliceBorderColor || DEFAULT_SETTINGS.sliceBorderColor;

    if (n === 1) {
      const color = entries[0].color || PALETTE[0];
      shapes = '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="' + color + '" stroke="' + borderColor + '" stroke-width="1"/>';
      if (entries[0].image) {
        const clipId = "wa-slice-clip-" + entries[0].id;
        shapes +=
          '<defs><clipPath id="' + clipId + '"><circle cx="' + cx + '" cy="' + cy + '" r="' + r + '"/></clipPath></defs>' +
          '<image href="' + entries[0].image + '" x="' + (cx - r) + '" y="' + (cy - r) + '" width="' + (r * 2) + '" height="' + (r * 2) + '" clip-path="url(#' + clipId + ')" preserveAspectRatio="xMidYMid slice"/>' +
          '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="' + borderColor + '" stroke-width="1"/>';
      }
      const label = escapeHtml(truncate(entries[0].label, 16));
      const labelAttrs = entries[0].image
        ? 'stroke="#FFFFFF" stroke-width="3" paint-order="stroke" fill="' + textColor + '"'
        : 'fill="' + textColor + '"';
      labels =
        '<text x="' + cx + '" y="' + (cy - textR) + '" transform="rotate(0 ' + cx + ' ' + cy + ')" ' +
        'text-anchor="middle" font-size="12" font-weight="600" ' + labelAttrs + '>' + label + '</text>';
    } else {
      const slices = computeSlices(entries);
      slices.forEach((slice, i) => {
        const a1 = slice.start;
        const a2 = slice.end;
        const a1r = (a1 - 90) * Math.PI / 180;
        const a2r = (a2 - 90) * Math.PI / 180;
        const x1 = (cx + r * Math.cos(a1r)).toFixed(2);
        const y1 = (cy + r * Math.sin(a1r)).toFixed(2);
        const x2 = (cx + r * Math.cos(a2r)).toFixed(2);
        const y2 = (cy + r * Math.sin(a2r)).toFixed(2);
        const largeArc = (a2 - a1) > 180 ? 1 : 0;
        const color = slice.entry.color || PALETTE[i % PALETTE.length];
        const pathD =
          'M ' + cx + ',' + cy + ' L ' + x1 + ',' + y1 +
          ' A ' + r + ',' + r + ' 0 ' + largeArc + ' 1 ' + x2 + ',' + y2 + ' Z';
        shapes += '<path d="' + pathD + '" fill="' + color + '" stroke="' + borderColor + '" stroke-width="1"/>';
        if (slice.entry.image) {
          const clipId = "wa-slice-clip-" + slice.entry.id;
          shapes +=
            '<defs><clipPath id="' + clipId + '"><path d="' + pathD + '"/></clipPath></defs>' +
            '<image href="' + slice.entry.image + '" x="' + (cx - r) + '" y="' + (cy - r) + '" width="' + (r * 2) + '" height="' + (r * 2) + '" clip-path="url(#' + clipId + ')" preserveAspectRatio="xMidYMid slice"/>' +
            '<path d="' + pathD + '" fill="none" stroke="' + borderColor + '" stroke-width="1"/>';
        }

        const label = escapeHtml(truncate(slice.entry.label, 16));
        const labelAttrs = slice.entry.image
          ? 'stroke="#FFFFFF" stroke-width="3" paint-order="stroke" fill="' + textColor + '"'
          : 'fill="' + textColor + '"';
        labels +=
          '<text x="' + cx + '" y="' + (cy - textR) + '" transform="rotate(' + slice.mid + ' ' + cx + ' ' + cy + ')" ' +
          'text-anchor="middle" font-size="12" font-weight="600" ' + labelAttrs + '>' + label + '</text>';
      });
    }

    const hub = buildHubMarkup(cx, cy, 11);

    return '<svg viewBox="0 0 320 320" width="100%" height="100%">' + shapes + labels + hub + '</svg>';
  }

  function parseInputToLabels(text) {
    const bracketMatches = [...text.matchAll(/\[([^\[\]]*)\]/g)]
      .map((m) => m[1].trim())
      .filter((s) => s.length > 0);
    if (bracketMatches.length > 0) return bracketMatches;
    return text
      .split("\n")
      .map((l) => l.trim())
      .filter((l) => l.length > 0);
  }

  // "어쩌고-5"처럼 "-" 뒤가 숫자만 있으면 그 숫자를 초기 가중치(1~10)로 쓰고,
  // "어쩌고-저쩌고"처럼 숫자가 아니면 기존처럼 note(당첨 후 하단에 표시)로 쓴다.
  function parseEntryFromRaw(raw) {
    const idx = raw.indexOf("-");
    if (idx === -1) return { label: raw, note: null, weight: 1 };
    const label = raw.slice(0, idx).trim() || raw;
    const rest = raw.slice(idx + 1).trim();
    if (/^\d+$/.test(rest)) {
      const w = clamp(parseInt(rest, 10), WEIGHT_MIN, WEIGHT_MAX);
      return { label, note: null, weight: w };
    }
    return { label, note: rest || null, weight: 1 };
  }

  function render() {
    const n = entries.length;
    const userPresets = getUserPresets();
    document.documentElement.lang = (settings.language === "en") ? "en" : "ko";
    if ((settings.backgroundType || "color") === "image" && settings.backgroundImage) {
      document.body.style.background = "#000000 url('" + settings.backgroundImage + "') center center / cover no-repeat fixed";
    } else {
      document.body.style.background = settings.background || DEFAULT_SETTINGS.background;
    }

    root.innerHTML =
      '<div class="wa-wrap">' +
        '<div class="wa-authbar">' +
          '<select class="wa-lang-select" id="wa-lang-select" title="' + t("languageLabel") + '">' +
            '<option value="ko" ' + ((settings.language || "ko") === "ko" ? "selected" : "") + '>한국어</option>' +
            '<option value="en" ' + ((settings.language || "ko") === "en" ? "selected" : "") + '>English</option>' +
          '</select>' +
          (currentUser
            ? '<span class="wa-authbar-email">' + escapeHtml(currentUser.email) + '</span>' +
              '<button class="wa-icon-btn" id="wa-logout-btn">' + t("logout") + '</button>'
            : '<button class="wa-icon-btn" id="wa-open-login">' + t("login") + '</button>' +
              '<button class="wa-icon-btn" id="wa-open-signup">' + t("signup") + '</button>') +
        '</div>' +
        '<div class="wa-brand"><h1 class="wa-title">FormWheel</h1><span class="wa-brand-tag">' + t("brandTag") + '</span></div>' +
        '<p class="wa-sub">' + t("subtitle") + '</p>' +
        '<div class="wa-grid">' +
          '<div class="wa-panel">' +
            '<div class="wa-panel-header">' +
              '<h2>' + t("itemListTitle")(n) + '</h2>' +
              '<div style="display:flex;gap:4px;">' +
                '<button class="wa-icon-btn" id="wa-copy-all-btn" ' + (n === 0 ? "disabled" : "") + '>' + (copyFeedback ? t("copied") : t("copyAll")) + '</button>' +
                '<button class="wa-icon-btn" id="wa-reset-effects-btn" ' + (spinning ? "disabled" : "") + '>' + t("resetEffects") + '</button>' +
                '<button class="wa-icon-btn" id="wa-clear-btn" ' + (n === 0 || spinning ? "disabled" : "") + '>' + t("clearAll") + '</button>' +
              '</div>' +
            '</div>' +
            '<div id="wa-form-slot"></div>' +
            '<div class="wa-settings-box">' +
              '<p class="wa-settings-title">' + t("rotationSettingsTitle") + '</p>' +
              '<div class="wa-settings-row">' +
                '<div class="wa-settings-field">' +
                  '<label for="wa-duration-input">' + t("durationLabel") + '</label>' +
                  '<input class="wa-input" id="wa-duration-input" type="number" min="' + DURATION_MIN + '" max="' + DURATION_MAX + '" step="0.1" value="' + settings.duration + '" ' + (spinning ? "disabled" : "") + '>' +
                '</div>' +
                '<div class="wa-settings-field">' +
                  '<label for="wa-rounds-input">' + t("roundsLabel") + '</label>' +
                  '<input class="wa-input" id="wa-rounds-input" type="number" min="' + ROUNDS_MIN + '" max="' + ROUNDS_MAX + '" step="1" value="' + settings.rounds + '" ' + (spinning ? "disabled" : "") + '>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="wa-settings-box">' +
              '<p class="wa-settings-title">' + t("popupSettingsTitle") + '</p>' +
              '<div class="wa-settings-row">' +
                '<div class="wa-settings-field">' +
                  '<label for="wa-popup-style-select">' + t("popupStyleLabel") + '</label>' +
                  '<select class="wa-input" id="wa-popup-style-select" ' + (spinning ? "disabled" : "") + '>' +
                    optionHtml("gold", settings.popupStyle, t("popupStyleGold")) +
                    optionHtml("bold", settings.popupStyle, t("popupStyleBold")) +
                    optionHtml("minimal", settings.popupStyle, t("popupStyleMinimal")) +
                    optionHtml("neon", settings.popupStyle, t("popupStyleNeon")) +
                    optionHtml("retro", settings.popupStyle, t("popupStyleRetro")) +
                    optionHtml("aurora", settings.popupStyle, t("popupStyleAurora")) +
                    optionHtml("paper", settings.popupStyle, t("popupStylePaper")) +
