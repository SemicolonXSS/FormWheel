<script>
(function () {
  const PALETTE = ["#E8B86D", "#6B7A97", "#C97B63", "#8FA998", "#D4A5C9", "#7E9CD8", "#B7A16C", "#7FB0A6"];
  const EFFECT_COLORS = PALETTE.concat(["#FFFFFF", "#E8B86D"]);
  const STORAGE_KEY = "formwheel-entries";
  const SETTINGS_KEY = "formwheel-settings";
  const USERS_KEY = "formwheel-users";
  const SESSION_KEY = "formwheel-session";
  const PRESETS_KEY = "formwheel-presets";
  const DEFAULT_SETTINGS = {
    duration: 5.6, rounds: 7, popupStyle: "gold", popupFont: "default", effect: "confetti",
    background: "#1B1A2E", backgroundType: "color", backgroundImage: null,
    hubType: "color", hubColor: "#E8B86D", hubImage: null,
    hubShape: "circle", wheelShape: "circle",
    wheelBorderColor: "#242338", wheelBorderWidth: 6,
    glitchColors: ["#39FF14", "#FF2079", "#00EAFF", "#FFFFFF"]
  };
  const POPUP_FONTS = {
    default: "Georgia, 'Iowan Old Style', serif",
    sans: "'Poppins', ui-sans-serif, -apple-system, sans-serif",
    blackhan: "'Black Han Sans', ui-sans-serif, sans-serif",
    dohyeon: "'Do Hyeon', ui-sans-serif, sans-serif",
    pen: "'Nanum Pen Script', cursive",
    mono: "'Courier New', ui-monospace, monospace",
  };
  const DURATION_MIN = 2, DURATION_MAX = 15;
  const ROUNDS_MIN = 2, ROUNDS_MAX = 20;
  const WEIGHT_MIN = 1, WEIGHT_MAX = 10;
  const BORDER_WIDTH_MIN = 0, BORDER_WIDTH_MAX = 20;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  let settings = { ...DEFAULT_SETTINGS };
  let entries = [];
  let editingId = null;
  let spinning = false;
  let currentRotation = 0;
  let lastWinner = null;
  let copyFeedback = false;

  let winnerModalOpen = false;
  let confirmClearOpen = false;
  let effectStarted = false;
  let effectCleanup = null;

  // --- 계정 관련 상태 ---
  let users = [];        // { id, email, passHash, verified }[]
  let currentUser = null; // { email } | null
  let authView = null;    // null | "login" | "signup"
  let authBusy = false;
  let authForm = { email: "", password: "", confirm: "", notRobot: false, error: "" };

  // --- 저장된 돌림판(프리셋) 상태: { [email]: [{id,name,createdAt,entries,settings}] } ---
  let presetsStore = {};
  let presetNameInputValue = "";

  const root = document.getElementById("wheel-app");

  function uid() {
    return "e" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }

  function resetAuthForm() {
    authForm = { email: "", password: "", confirm: "", notRobot: false, error: "" };
  }

  // Claude 아티팩트 안에서는 window.storage(영구 저장소)를 쓰고,
  // 다른 곳에 호스팅해서 독립 웹사이트로 쓸 때는 자동으로 localStorage로 전환된다.
  const hasArtifactStorage = typeof window !== "undefined" && window.storage && typeof window.storage.get === "function";

  async function storageGet(key, shared) {
    if (hasArtifactStorage) {
      try {
        return await window.storage.get(key, !!shared);
      } catch (e) {
        return null;
      }
    }
    try {
      const raw = localStorage.getItem((shared ? "shared:" : "") + key);
      return raw ? { value: raw } : null;
    } catch (e) {
      return null;
    }
  }

  async function storageSet(key, value, shared) {
    if (hasArtifactStorage) {
      try {
        return await window.storage.set(key, value, !!shared);
      } catch (e) {
        return null;
      }
    }
    try {
      localStorage.setItem((shared ? "shared:" : "") + key, value);
      return true;
    } catch (e) {
      return null;
    }
  }

  function clamp(v, min, max) {
    if (Number.isNaN(v)) return min;
    return Math.min(max, Math.max(min, v));
  }

  async function loadSettings() {
    try {
      const res = await storageGet(SETTINGS_KEY, false);
      if (res && res.value) {
        const parsed = JSON.parse(res.value);
        settings = { ...DEFAULT_SETTINGS, ...parsed };
      }
    } catch (e) {
      settings = { ...DEFAULT_SETTINGS };
    }
  }

  async function saveSettings() {
    try {
      await storageSet(SETTINGS_KEY, JSON.stringify(settings), false);
    } catch (e) {
      console.error("설정 저장 실패", e);
    }
  }

  async function loadEntries() {
    try {
      const res = await storageGet(STORAGE_KEY, false);
      if (res && res.value) entries = JSON.parse(res.value);
    } catch (e) {
      entries = [];
    }
  }

  async function saveEntries() {
    try {
      await storageSet(STORAGE_KEY, JSON.stringify(entries), false);
    } catch (e) {
      console.error("저장 실패", e);
    }
  }

  // --- 계정 저장/불러오기 (사용자 목록/인증대기는 공용 저장소 사용) ---
  async function loadUsers() {
    try {
      const res = await storageGet(USERS_KEY, true);
      if (res && res.value) users = JSON.parse(res.value);
    } catch (e) {
      users = [];
    }
  }

  async function saveUsers() {
    try {
      await storageSet(USERS_KEY, JSON.stringify(users), true);
    } catch (e) {
      console.error("사용자 저장 실패", e);
    }
  }

  async function loadSession() {
    try {
      const res = await storageGet(SESSION_KEY, false);
      if (res && res.value) {
        const parsed = JSON.parse(res.value);
        if (parsed && parsed.email) currentUser = { email: parsed.email };
      }
    } catch (e) {
      currentUser = null;
    }
  }

  async function saveSession() {
    try {
      await storageSet(SESSION_KEY, JSON.stringify({ email: currentUser ? currentUser.email : null }), false);
    } catch (e) {
      console.error("세션 저장 실패", e);
    }
  }

  // --- 저장된 돌림판(프리셋): 계정별 목록을 공용 저장소에 보관 ---
  async function loadPresetsStore() {
    try {
      const res = await storageGet(PRESETS_KEY, true);
      if (res && res.value) presetsStore = JSON.parse(res.value);
    } catch (e) {
      presetsStore = {};
    }
  }

  async function savePresetsStore() {
    try {
      await storageSet(PRESETS_KEY, JSON.stringify(presetsStore), true);
    } catch (e) {
      console.error("프리셋 저장 실패", e);
    }
  }

  function getUserPresets() {
    if (!currentUser) return [];
    return presetsStore[currentUser.email] || [];
  }

  // 프리셋에는 "꾸미기" 관련 값만 담는다. 회전 시간/횟수, 팝업 스타일, 효과는
  // 프리셋과 무관하게 유지되는 개인 설정으로 취급한다.
  function extractStyleSettings(s) {
    return {
      background: s.background,
      backgroundType: s.backgroundType,
      backgroundImage: s.backgroundImage,
      hubType: s.hubType,
      hubColor: s.hubColor,
      hubImage: s.hubImage,
      hubShape: s.hubShape,
      wheelShape: s.wheelShape,
      wheelBorderColor: s.wheelBorderColor,
      wheelBorderWidth: s.wheelBorderWidth,
    };
  }

  async function saveCurrentPreset() {
    if (!currentUser || entries.length === 0) return;
    const name = presetNameInputValue.trim();
    if (!name) return;
    const list = presetsStore[currentUser.email] || (presetsStore[currentUser.email] = []);
    list.unshift({
      id: uid(),
      name,
      createdAt: Date.now(),
      entries: JSON.parse(JSON.stringify(entries)),
      settings: JSON.parse(JSON.stringify(extractStyleSettings(settings))),
    });
    if (list.length > 20) list.length = 20;
    await savePresetsStore();
    presetNameInputValue = "";
    render();
  }

  function loadPreset(id) {
    if (!currentUser || spinning) return;
    const list = presetsStore[currentUser.email] || [];
    const preset = list.find((p) => p.id === id);
    if (!preset) return;
    entries = JSON.parse(JSON.stringify(preset.entries));
    const ps = preset.settings || {};
    settings = {
      ...settings,
      background: ps.background !== undefined ? ps.background : settings.background,
      backgroundType: ps.backgroundType !== undefined ? ps.backgroundType : settings.backgroundType,
      backgroundImage: ps.backgroundImage !== undefined ? ps.backgroundImage : settings.backgroundImage,
      hubType: ps.hubType !== undefined ? ps.hubType : settings.hubType,
      hubColor: ps.hubColor !== undefined ? ps.hubColor : settings.hubColor,
      hubImage: ps.hubImage !== undefined ? ps.hubImage : settings.hubImage,
      hubShape: ps.hubShape !== undefined ? ps.hubShape : settings.hubShape,
      wheelShape: ps.wheelShape !== undefined ? ps.wheelShape : settings.wheelShape,
      wheelBorderColor: ps.wheelBorderColor !== undefined ? ps.wheelBorderColor : settings.wheelBorderColor,
      wheelBorderWidth: ps.wheelBorderWidth !== undefined ? ps.wheelBorderWidth : settings.wheelBorderWidth,
    };
    currentRotation = 0;
    lastWinner = null;
    editingId = null;
    saveEntries();
    saveSettings();
    render();
  }

  async function deletePreset(id) {
    if (!currentUser) return;
    const list = presetsStore[currentUser.email] || [];
    presetsStore[currentUser.email] = list.filter((p) => p.id !== id);
    await savePresetsStore();
    render();
  }

  async function hashPassword(pw) {
    const enc = new TextEncoder().encode("formwheel-salt-v1:" + pw);
    const buf = await crypto.subtle.digest("SHA-256", enc);
    return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  // --- 회원가입: 정보 입력 + "로봇이 아닙니다" 체크 확인 ---
  async function submitSignup() {
    authForm.error = "";
    const email = authForm.email.trim().toLowerCase();
    const pw = authForm.password;
    const confirmPw = authForm.confirm;
    if (!EMAIL_RE.test(email)) { authForm.error = "올바른 이메일 형식이 아니에요."; render(); return; }
    if (pw.length < 6) { authForm.error = "비밀번호는 6자 이상이어야 해요."; render(); return; }
    if (pw !== confirmPw) { authForm.error = "비밀번호가 일치하지 않아요."; render(); return; }
    if (!authForm.notRobot) { authForm.error = "로봇이 아님을 확인해주세요."; render(); return; }
    if (users.find((u) => u.email === email && u.verified)) { authForm.error = "이미 가입된 이메일이에요."; render(); return; }

    authBusy = true;
    render();
    const passHash = await hashPassword(pw);
    users = users.filter((u) => u.email !== email);
    users.push({ id: uid(), email, passHash, verified: true });
    await saveUsers();
    authBusy = false;
    currentUser = { email };
    await saveSession();
    authView = null;
    resetAuthForm();
    render();
  }

  async function submitLogin() {
    authForm.error = "";
    const email = authForm.email.trim().toLowerCase();
    const pw = authForm.password;
    const user = users.find((u) => u.email === email && u.verified);
    if (!user) { authForm.error = "가입되지 않은 이메일이에요."; render(); return; }
    authBusy = true;
    render();
    const passHash = await hashPassword(pw);
    authBusy = false;
    if (passHash !== user.passHash) { authForm.error = "비밀번호가 올바르지 않아요."; render(); return; }
    currentUser = { email };
    await saveSession();
    authView = null;
    resetAuthForm();
    render();
  }

  function logout() {
    currentUser = null;
    saveSession();
    render();
  }

  function updateEntry(id, label) {
    const e = entries.find((x) => x.id === id);
    if (!e || !label.trim()) return;
    e.label = label.trim();
    editingId = null;
    saveEntries();
    render();
  }

  function deleteEntry(id) {
    entries = entries.filter((x) => x.id !== id);
    if (entries.length === 0) lastWinner = null;
    saveEntries();
    render();
  }

  // --- 항목 모두 복사: [항목-숫자] 문법을 그대로 써서 나중에 다시 붙여넣어도 가중치가 유지되게 구성 ---
  function entriesToText() {
    return entries
      .map((e) => ((e.weight && e.weight !== 1) ? (e.label + "-" + e.weight) : e.label))
      .join("\n");
  }

  function fallbackCopy(text) {
    try {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      return true;
    } catch (e) {
      return false;
    }
  }

  async function copyAllEntries() {
    if (entries.length === 0) return;
    const text = entriesToText();
    let ok = false;
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
        ok = true;
      }
    } catch (e) {
      ok = false;
    }
    if (!ok) ok = fallbackCopy(text);
    if (ok) {
      copyFeedback = true;
      render();
      setTimeout(() => { copyFeedback = false; render(); }, 1500);
    }
  }

  // --- 전체 삭제 (인앱 확인창 사용: 일부 환경에서 window.confirm이 동작하지 않아 교체) ---
  function requestClearAll() {
    if (entries.length === 0 || spinning) return;
    confirmClearOpen = true;
    render();
  }

  function cancelClearAll() {
    confirmClearOpen = false;
    render();
  }

  function confirmClearAll() {
    entries = [];
    lastWinner = null;
    currentRotation = 0;
    confirmClearOpen = false;
    saveEntries();
    render();
  }

  // --- 회전/팝업 효과 설정만 초기화 (배경·색상 커스텀은 유지) ---
  function resetEffectSettings() {
    if (spinning) return;
    settings.duration = DEFAULT_SETTINGS.duration;
    settings.rounds = DEFAULT_SETTINGS.rounds;
    settings.popupStyle = DEFAULT_SETTINGS.popupStyle;
    settings.effect = DEFAULT_SETTINGS.effect;
    saveSettings();
    render();
  }

  // --- 당첨 팝업에서 해당 항목 바로 삭제 ---
  function deleteWinnerEntry() {
    if (!lastWinner) return;
    const id = lastWinner.id;
    entries = entries.filter((x) => x.id !== id);
    lastWinner = null;
    winnerModalOpen = false;
    stopEffect();
    saveEntries();
    render();
  }

  function updateDuration(raw) {
