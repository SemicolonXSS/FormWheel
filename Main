    saveSettings();
    render();
  }

  function updateBackgroundType(val) {
    if (!currentUser || spinning) return;
    settings.backgroundType = val;
    saveSettings();
    render();
  }

  function updateBackgroundImage(file) {
    if (!currentUser || spinning || !file) return;
    const reader = new FileReader();
    reader.onload = function (ev) {
      const img = new Image();
      img.onload = function () {
        const maxW = 1600;
        const scale = Math.min(1, maxW / img.width);
        const w = Math.max(1, Math.round(img.width * scale));
        const h = Math.max(1, Math.round(img.height * scale));
        const canvas = document.createElement("canvas");
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);
        settings.backgroundImage = canvas.toDataURL("image/jpeg", 0.82);
        saveSettings();
        render();
      };
      img.onerror = function () { /* 이미지를 읽지 못하면 조용히 무시 */ };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function removeBackgroundImage() {
    if (!currentUser) return;
    settings.backgroundImage = null;
    saveSettings();
    render();
  }

  function updateHubColor(val) {
    if (!currentUser || spinning) return;
    settings.hubColor = val;
    saveSettings();
    render();
  }

  function updateHubType(val) {
    if (!currentUser || spinning) return;
    settings.hubType = val;
    saveSettings();
    render();
  }

  function updateHubImage(file) {
    if (!currentUser || spinning || !file) return;
    const reader = new FileReader();
    reader.onload = function (ev) {
      const img = new Image();
      img.onload = function () {
        const size = 120;
        const canvas = document.createElement("canvas");
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext("2d");
        const s = Math.min(img.width, img.height);
        const sx = (img.width - s) / 2;
        const sy = (img.height - s) / 2;
        ctx.drawImage(img, sx, sy, s, s, 0, 0, size, size);
        settings.hubImage = canvas.toDataURL("image/jpeg", 0.85);
        saveSettings();
        render();
      };
      img.onerror = function () { /* 이미지를 읽지 못하면 조용히 무시 */ };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function removeHubImage() {
    if (!currentUser) return;
    settings.hubImage = null;
    saveSettings();
    render();
  }

  function updateWheelBorderColor(val) {
