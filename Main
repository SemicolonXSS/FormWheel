  function hexToRgb(hex) {
    const h = String(hex || "").replace("#", "");
    const full = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
    const bigint = parseInt(full, 16);
    if (Number.isNaN(bigint)) return "57,255,136";
    return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255].join(",");
  }

  function submitSecretCode() {
    const code = secretCodeInputValue.trim();
    if (code.toLowerCase() === "fwsecret") {
      settings.secretUnlocked = true;
      secretCodeInputValue = "";
      secretCodeError = "";
      saveSettings();
      render();
    } else {
      secretCodeError = t("secretWrongCode");
      render();
    }
  }

