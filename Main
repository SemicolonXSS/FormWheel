    if (!e) return;
    e.weight = clamp(parseInt(raw, 10), WEIGHT_MIN, WEIGHT_MAX);
    saveEntries();
    render();
  }

  // --- 로그인한 사용자만 배경/항목 색상/중앙 원 색상을 바꿀 수 있음 ---
  function updateBackground(val) {
